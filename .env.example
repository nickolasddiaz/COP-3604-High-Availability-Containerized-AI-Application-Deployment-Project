# example of a .env without exposing real values
# false uses openrouter, true uses the local model
LOCAL_AI_DEV = "false"


# needed if LOCAL_AI_DEV is false
OPENROUTER_API_KEY = "your-openrouter-api-key-here"
OPENROUTER_MODEL = "gemini-3.8-flash"
OPENROUTER_EMBED_MODEL = "google/gemini-embedding-2"
EMBEDDING_DIM="768"


# needed if LOCAL_AI_DEV is true
LOCAL_MODEL = "llama3.2"
LOCAL_MODEL_URL = "http://localhost:11434"
# if changing LOCAL_EMBED_MODEL make sure to update the init.sql: vector(N)
LOCAL_EMBED_MODEL= "nomic-embed-text"
LOCAL_EMBED_MODEL_URL = "http://localhost:11434"

# DB settings
DB_NAME=mydatabase # needed cost me 3 hours of my life 😐
DB_USER=admin_user
DB_PASSWORD=secret_password
DB_HOST=database
DB_PORT=5432
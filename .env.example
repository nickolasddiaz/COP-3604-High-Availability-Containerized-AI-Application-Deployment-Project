# example of a .env without exposing real values
# false uses openrouter, true uses the local model
LOCAL_AI_DEV = "false"
# needed if LOCAL_AI_DEV is false
OPENROUTER_API_KEY = "your-openrouter-api-key-here"
# needed if LOCAL_AI_DEV is false
OPENROUTER_MODEL = "google/gemini-2.5-flash"
# needed if LOCAL_AI_DEV is true
LOCAL_MODEL = "llama3.2"
# needed if LOCAL_AI_DEV is true
LOCAL_MODEL_URL = "http://localhost:11434"
PYTHONWARNINGS="ignore:Core Pydantic V1 functionality isn't compatible:UserWarning"

# DB settings
DB_NAME=mydatabase # needed cost me 3 hours of my life 😐
DB_USER=admin_user
DB_PASSWORD=secret_password
DB_HOST=database
DB_PORT=5432

# Toggle: false = OpenRouter (dev), true = Local Ollama (final GCP deployment)
LOCAL_EMBED_DEV=false
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
LOCAL_EMBED_MODEL=nomic-embed-text
LOCAL_MODEL_URL=http://ollama:11434
EMBEDDING_DIM=768
PDF_DIR=/app/pdfs
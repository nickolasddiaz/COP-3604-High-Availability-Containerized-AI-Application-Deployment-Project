# example of a .env without exposing real values
LOCAL_AI_DEV = "false" # false uses openrouter, true uses the local model
OPENROUTER_API_KEY = "your-openrouter-api-key-here" # needed if LOCAL_AI_DEV is false
OPENROUTER_MODEL = "meta-llama/llama-3.2-3b-instruct" # needed if LOCAL_AI_DEV is false
LOCAL_MODEL = "llama3.2", # needed if LOCAL_AI_DEV is true
LOCAL_MODEL_URL = "http://localhost:11434" # needed if LOCAL_AI_DEV is true
PYTHONWARNINGS="ignore:Core Pydantic V1 functionality isn't compatible:UserWarning"